cin.ignore(numeric_limits<streamsize>::max(), '\n'); 
        }
    }
    if (k == 0) {
        cout << "The total sum of " << k << " integers is: " << sum_k << endl;
        return 0; 
    }
    for (int i = 1; i <= k; i++) {
        cout << "Enter integer nr. " << i << ": ";
        while (true) {
